while True:
	try:
		print("Greetings, Enter Your Mark:")
		mark = input()
		mark = int(mark)


		if int(mark) > 100:
			print("You have typed a wrong number, mark should be between (0 - 100)")

		elif int(mark) < 0:
			print("You have typed a wrong number, mark should be between (0 - 100)")	

		elif int(mark) == 100:
			print("Congratulations You have Achieved A+")

		elif int(mark) >= 80:
			print("Congratulations You have Achieved A+")

		elif int(mark) >= 70:
			print("Congratulations You Have Got A")

		elif int(mark) >= 60:
			print("You Have got the grade B")

		elif int(mark) >= 50:
			print("You have got the grade C")

		elif int(mark) >= 40:
			print ("You have got the grade D")

		elif int(mark) < 40:
			print ("Unfortunatly You have failed with the grade F")

	except :
		print("Enter A Valid Number")	
